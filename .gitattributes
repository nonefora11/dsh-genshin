# 统一行尾，避免 Windows 上每次 commit 都刷 "LF will be replaced by CRLF"
* text=auto eol=lf

# PowerShell 脚本保持 CRLF（Windows PowerShell 5.1 对 BOM/换行更挑剔）
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制，别做行尾转换
*.tgz binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.zip binary
